# Route only the @stacklet scope through Stacklet's private CodeArtifact
# repository; everything else comes from the public registry regardless of
# developer-global .npmrc defaults (aws codeartifact login rewrites ~/.npmrc
# to point the DEFAULT registry at CodeArtifact, which would otherwise make
# every package fetch depend on a fresh AWS session).
#
# Auth: run `npm run auth` (same flow as the sinistral/platform-ui repos) —
# it stores a CodeArtifact token for this host in your user-level ~/.npmrc,
# which npm merges with this file.
registry=https://registry.npmjs.org/
@stacklet:registry=https://stacklet-653993915282.d.codeartifact.us-east-1.amazonaws.com/npm/stacklet.client.ui/

# Note: @stacklet/ui declares peers for its legacy v1/MUI components (React
# 19, MUI 7, ...) that Superset (React 17) cannot satisfy; the `overrides`
# block in package.json pins the conflicting edges instead of disabling peer
# resolution globally (upstream relies on npm auto-installing its root
# peerDependencies, e.g. react-ace).
